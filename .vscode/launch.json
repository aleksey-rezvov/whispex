{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run whispex CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/whispex.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Run whispex GUI",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/whispex-gui.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Run with UV",
            "type": "python",
            "request": "launch",
            "module": "uv.run",
            "args": ["${file}"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}
